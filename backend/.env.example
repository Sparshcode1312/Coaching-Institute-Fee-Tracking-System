# Coaching Institute Fee Tracking System & Parent Portal
# Backend Environment Configuration
# Copy this file to .env and provide your project credentials.

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
# Project URL (HTTPS endpoint)
SUPABASE_URL=https://your-project.supabase.co

# Public anonymous key (used for client-level calls)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret Service Role Key (CRITICAL: grants full administrative bypass of RLS).
# MUST ONLY be set on the backend. NEVER expose to frontend bundles or client devices.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Direct PostgreSQL Connection URI for running raw migrations
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# -----------------------------------------------------------------------------
# Authentication & OTP Security Settings
# -----------------------------------------------------------------------------
# OTP expiration duration in seconds (Supabase default is 300 seconds = 5 minutes)
OTP_EXPIRY_SECONDS=300

# Rate Limiting & Abuse Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH_ATTEMPTS=5

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info

