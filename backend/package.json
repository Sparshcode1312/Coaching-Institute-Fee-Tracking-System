{
  "name": "coaching-fee-tracking-backend",
  "version": "1.0.0",
  "description": "Production Coaching Institute Fee Tracking System and Parent Portal Backend for Company A, Jaipur",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
