# Server Configuration
PORT=4001
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Supabase Configuration (Leave placeholder for deterministic local in-memory simulation mode)
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Auth & Security Settings
OTP_EXPIRY_SECONDS=300
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH_ATTEMPTS=10

# Mock Payment Gateway Secret
MOCK_PAYMENT_SECRET=coaching-institute-mock-secret-jaipur-2026

# Logging
LOG_LEVEL=info

